import java.util.Arrays;
class Result
{
  // Matrix A[i] has dimension p[i-1] x p[i]  for i = 1..n 
    static public int recursion(int i, int j, int[] p, int[][] memo) {
        if(i == j) return memo[i][j] = 0;
        if(memo[i][j] != -1) return memo[i][j];
        int minCost = Integer.MAX_VALUE;
        for(int k = i; k < j; k++) {
            int steps = (p[i - 1] * p[k] * p[j]) + recursion(i, k, p, memo) + recursion(k+1, j, p, memo);
            minCost = Math.min(steps, minCost);
        }
        return memo[i][j] = minCost;
    }
  static int matrixChainMultiplication(int p[], int n){
    // Write your code here
      int[][] memo = new int[n+1][n+1];
      for(int[] i : memo) Arrays.fill(i, -1);
      return recursion(1, n, p, memo);
      
  }
}
