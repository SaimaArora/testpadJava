2) select m.year, r.stars from Movie m, Rating r on m.mId = r.mId where r.stars >= 4 order by r.stars;
3) select m.title from Movie m left join Rating r on m.mId = r.mId where r.stars = null;
4) select r.name from Reviewer r, Rating s on r.rId = s.rid where s.ratingDate is null;
5) select r.name, m.title, s.stars, s.ratingDate from Rating s inner join Reviewer r on r.rId = s.rId inner join Movie m on m.mId = s.mId order by r.name, m.title, s.stars;
6) select m.title, MAX(s.stars) from Rating s join Movie m on s.mId = m.mId group by(m.title) order by m.title;
