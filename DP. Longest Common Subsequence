import java.util.Arrays;
class Result
{
    static int recursion(int i, int j, String s1, String s2, int[][] memo) {
        if (i >= s1.length() || j >= s2.length()) return 0;
        if (memo[i][j] != -1) return memo[i][j];
        if(s1.charAt(i) == s2.charAt(j)) {
            return memo[i][j] = 1 + recursion(i + 1, j +1 , s1, s2, memo);
        }
        return memo[i][j] = Math.max(recursion(i+1, j, s1, s2, memo), recursion(i, j+1 ,s1, s2, memo));
           
    }
  static int longestCommonSubsequence(String str1, String str2){
    // Write your code here
      int m = str1.length(), n  =str2.length();
      int[][] memo = new int[m][n];
      for(int[] arr : memo) Arrays.fill(arr, -1); 
      return recursion(0, 0, str1, str2, memo);
  }
}
