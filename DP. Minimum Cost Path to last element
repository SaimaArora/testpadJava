class Result
{
    static int recursion(int i, int j, int[][] cost, int m,int n, int[][] memo) {
        if(i >= m || j >= n) return 100000000;
        if(i == m - 1 && j == n - 1) return cost[i][j];
        if(memo[i][j] != -1) return memo[i][j];
        int right =  recursion(i, j+1, cost,m, n, memo);
        int down = recursion(i+1, j, cost, m, n, memo);
        int diag = recursion(i+1, j+1, cost, m, n, memo);
        return memo[i][j] = cost[i][j] + Math.min(right, Math.min(down, diag));
    }
