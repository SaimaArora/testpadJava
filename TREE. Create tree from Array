// Return the root node of the tree
static Node buildTree(int arr[], int n) {
  Node root = null;
  // Complete the function body
    if(n == 0) return null;
    Queue<Node> q = new LinkedList<>();
    int ind = 0;
    Node temp = new Node(arr[ind++]);
    q.offer(temp);
    while(!q.isEmpty() && ind < n) {
        Node par = q.poll();
        if(ind < n) par.left = new Node(arr[ind++]);
        if(ind < n)par.right = new Node(arr[ind++]);
        if(par.left != null) q.offer(par.left);
        if(par.right != null) q.offer(par.right);
    }
  return temp;
}
