import java.util.*;
class Solve {
  /*
   * Return all the permutations of the given string in any order,
   * as they will be sorted at the back-end before printing.
   */
    
    private void swap(int a, int b, char[] arr) {
        char temp = arr[a];
        arr[a] = arr[b];
        arr[b] = temp;
        return;
    }
  void recursion (char[] arr, int ind, ArrayList<String> result) {
      if (ind == arr.length) {
          result.add(new String(arr));
          return;
      }
      for (int i = ind; i < arr.length; i++) {
          swap(i, ind, arr);
          recursion(arr, ind+1, result);
          swap(i, ind, arr);
      }
  }
  ArrayList<String> permute(String str) {
    // Write your code here
      ArrayList<String> result = new ArrayList<>();
      char[] arr = str.toCharArray();
      recursion(arr, 0, result);
        return result;
  }
}
