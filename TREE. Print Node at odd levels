 *  class Node {
 *    int data;
 *    Node left; 
 *    Node right;
 *    public Node() {
 *      data = 0;
 *    }
 *    public Node(int d)  {
 *      data = d;
 *    }
 *  }
 *
 *  The above class defines a tree node.
 */
class Result {
    static class Element{
        Node root;
        int level;
        Element(Node r, int l) {
            root = r;
            level = l;
        }
    }
  static void printOdd(Node root) {
    // Write your code here
      int lev = 0;
      if(root == null) return;
      Queue<Element> q = new LinkedList<>();
      q.offer(new Element(root, lev));
      while(!q.isEmpty()) {
          Node par = q.peek().root;
           lev = q.peek().level;
          q.poll();
        if(lev%2==0) {
              System.out.print(par.data+" ");
          }
          if(par.left != null) {
              q.offer(new Element(par.left, lev+1));
          }
          if(par.right != null) {
              q.offer(new Element(par.right, lev+1));
          }
      }
    
  }
}
