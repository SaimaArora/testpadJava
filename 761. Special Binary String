class Solution {
    public String makeLargestSpecial(String s) {
        List<String> mount = new ArrayList<>();
        int count = 0, st = 0;
        StringBuilder str = new StringBuilder();
        for(int end = 0; end < s.length(); end++) {
            if(s.charAt(end) == '1') count++;
            else count--;
            if(count == 0) {
                String curr = s.substring(st+1, end);
                mount.add("1" + makeLargestSpecial(curr)+ "0");
                st = end+1;
            }
            
        }
        Collections.sort(mount, Collections.reverseOrder());
        for(int i = 0; i < mount.size(); i++) {
            str.append(mount.get(i));
        }
        return str.toString();
    }
}
