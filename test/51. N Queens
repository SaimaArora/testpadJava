class Solution {
    private void checkQueen(int row, Set<Integer> posDiag, Set<Integer> negDiag, Set<Integer> col, char[][] board, List<List<String>> result) {
        if(row == board.length) {
            List<String> sol = new ArrayList<>();
            for(char[] ch : board) {
                sol.add(new String(ch));
            }
            result.add(new ArrayList<>(sol));
            return ;
        }
        for(int j = 0; j < board[0].length; j++) {
            int pos = row+j, neg = row - j;
            if(posDiag.contains(pos) || negDiag.contains(neg) || col.contains(j)) continue;
            board[row][j] = 'Q';
            col.add(j);
            posDiag.add(pos); negDiag.add(neg);
            checkQueen(row+1, posDiag, negDiag, col, board, result);
            board[row][j] = '.';
            col.remove(j);
            posDiag.remove(pos); negDiag.remove(neg);
        }
    }
    public List<List<String>> solveNQueens(int n) {
        Set<Integer> posDiag = new HashSet<>();
        Set<Integer> negDiag = new HashSet<>();
        Set<Integer> col = new HashSet<>();
        char[][] board = new char[n][n];
        List<List<String>> result = new ArrayList<>();
        for(int i = 0; i < board.length; i++) {
            for(int j = 0; j < board[0].length; j++) {
                board[i][j] = '.';
            }
        }
        checkQueen(0, posDiag, negDiag, col, board, result);
        return result;

    }
}
