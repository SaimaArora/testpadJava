
    static List<List<Integer>> solveWaterConnection(int n, int p, int[] a, int[] b, int[] d) {
        int[] nextHouse = new int[n+1];
        int[] diameter = new int[n+1];
        boolean[] hasIncoming = new boolean[n+1];
        List<List<Integer>> res = new ArrayList<>();
        for(int i = 0; i < p; i++) {
            nextHouse[a[i]] = b[i];
            diameter[a[i]] = d[i];
            hasIncoming[b[i]] = true;
        }
        for(int i = 1; i < n; i++) {
            //if tank
            if(!hasIncoming[i] && nextHouse[i] != 0) {
                int curr = i;
                int minDia = Integer.MAX_VALUE;
                while(nextHouse[curr] != 0) {
                    minDia = Math.min(minDia, diameter[curr]);
                    curr = nextHouse[curr];
                }
                res.add(Arrays.asList(i, curr, minDia));
            }
        }
        return res;
    }



    public static void main(String[] args) {
        int n = 9, p = 6;
        int a[] = {7, 5, 4, 2, 9, 3};
        int[] b = {4, 9, 6, 8, 7, 1};
        int[] d = {98, 72, 10, 22, 17, 66};
        List<List<Integer>> res = solveWaterConnection(n, p, a, b, d);
        for(List<Integer> arr: res) {
            System.out.println(arr.toString());
        }
