
    public int longestRatingWithCostAddition(int[] rating, int[] cost, int k) {
        int n = rating.length, l = 0, maxCost = 0, total = 0, ans = 0;
        HashMap<Integer, Integer> weight = new HashMap<>();
        for(int r = 0;r < n; r++) {
            weight.put(rating[r], weight.getOrDefault(rating[r], 0) + cost[r]);
            maxCost = Math.max(maxCost, weight.get(rating[r]));
            total+=cost[r];
            while(total - maxCost > k) {
                weight.put(rating[l], weight.get(rating[l]) - cost[l]);
                total-=cost[l];
                l++;
            }
            ans = Math.max(ans, r - l+1);
        }

        //part2 - return all distinct/unique combinations that are formed for the given length
        int len = ans;
        total = 0;
        weight = new HashMap<>();
        HashSet<String> result = new HashSet<>();
        for(int r = 0; r < n; r++) {
            total+=cost[r];
            weight.put(rating[r], weight.getOrDefault(rating[r], 0) + cost[r]);
            if(r>=len) {
                int left = r - len;
                total-=cost[left];
                weight.put(rating[left], weight.get(rating[left])-cost[left]);
                if(weight.get(rating[left]) == 0) weight.remove(rating[left]);
            }
            if(r>= len - 1) {
                for(int key:weight.keySet()){
                    int size = weight.get(key);
                    if(total - size <= k) {
                        result.add((r - len +1)+","+ r+"," +key);
                    }
                }
            }
        }

        return result.size();
    }
