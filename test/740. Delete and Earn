class Solution {
    public int recursion(int[] points, int ind, int[] memo) {
        if(ind >= points.length) return 0;
        if(memo[ind] != -1) return memo[ind];
        int notTake = recursion(points, ind+1, memo);
        int take = points[ind] + recursion(points, ind+2, memo);
        return memo[ind] = Math.max(take, notTake); 
    }
    public int deleteAndEarn(int[] nums) {
        int maxVal = 0;
        for(int i = 0; i < nums.length; i++) {
            maxVal = Math.max(maxVal, nums[i]);
        }
        int[] points = new int[maxVal+1];
        int[] memo = new int[maxVal+1];
        Arrays.fill(memo, -1);
        for(int num : nums) {
            points[num]+=num;
        }
        return recursion(points, 0, memo);
    }
}
