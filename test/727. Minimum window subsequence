    public int minimumWindowSubsequence(String s, String t) {
        int n = s.length(), m = t.length();
//        int st = 0, end = 0;
        int[][] memo = new int[n][m];
        int ans = -1, ind = -1;
        for(int[] ar: memo) Arrays.fill(ar, -1);
        for(int st = 0; st < n; st++) {
            if(s.charAt(st) == t.charAt(0)){
                int end = solve(st, 0, s, t, memo);
                if(end < n) {
                    if(ans == -1){
                        ind = st;
                        ans = end - st+1;
                    }
                    else if(ans > end - st+1) {
                        ind = st;
                        ans = end-st+1;
                    }
                }
            }
        }
        return ans;

    }
    public int solve(int i, int j, String s, String t, int[][] memo) {
        if(j == t.length()) return i - 1;
        if(i == s.length()) return 100000;
        if(memo[i][j] != -1) return memo[i][j];
        //char matches
        int res = -1;
        if(s.charAt(i) == t.charAt(j)) {
            res = solve(i+1, j+1, s, t, memo);
        }
        else{
            res = solve(i+1, j, s, t, memo);
        }
        return memo[i][j] = res;
    }
