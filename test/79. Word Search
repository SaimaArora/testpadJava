class Solution {
    boolean isValid(int i, int j, char[][] board, String s, int ind, boolean[][] visited) {
        return i >= 0 && j >= 0 && i < board.length && j < board[0].length && s.charAt(ind) == board[i][j] && !visited[i][j];
    }
    private boolean searchWord(int i, int j, int ind, char[][] board, String s, boolean[][] visited) {
        if(ind == s.length()) return true;
        if(!isValid(i, j, board, s, ind, visited)) {
            return false;
        }
        visited[i][j] = true;
        boolean result = searchWord(i+1, j, ind+1, board, s, visited) || searchWord(i, j+1, ind+1, board, s, visited) || searchWord(i-1, j, ind+1, board, s, visited)|| searchWord(i, j - 1, ind+1, board, s, visited);
        visited[i][j] = false;
        return result;

    }
    public boolean exist(char[][] board, String word) {
        boolean[][] visited = new boolean[board.length][board[0].length];
        for(int i = 0; i < board.length; i++) {
            for(int j = 0; j < board[0].length; j++) {
                if(board[i][j] == word.charAt(0)) {
                    if(searchWord(i, j, 0, board, word, visited)) return true;
                }
            }
        }
        return false;
    }
}
