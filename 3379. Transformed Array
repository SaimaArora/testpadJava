class Solution {
    public int[] constructTransformedArray(int[] nums) {
        int n = nums.length;
        int[] result = new int[n];
        for(int i = 0; i < nums.length; i++) {
            if (nums[i] > 0) {
                int pos = (i+nums[i]) % n;
                result[i] = nums[pos];
            } else if (nums[i] < 0) {
                int pos = ((i - Math.abs(nums[i])) % n + n) % n;
                result[i] = nums[pos];
            } else {
                result[i] = nums[i];
            }
        }
        return result;
    }
}
