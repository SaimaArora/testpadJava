class Solution {
    public Node copyRandomList(Node head) {
        HashMap<Node, Node> hs = new HashMap<>();
        Node temp = head;
        while (temp != null) {
            if(!hs.containsKey(temp)) hs.put(temp, new Node(temp.val));
            temp = temp.next;
        }
        temp = head;
        while(temp != null) {
            Node n = temp.next, r = temp.random;
            Node newNode = hs.get(temp);
            newNode.next = hs.get(n);
            newNode.random = hs.get(r);
            temp = temp.next;
        }
        return hs.get(head);
    }
}
