void BFS(int v) 
{ 
    Queue<Integer> bfs = new LinkedList<>();
    bfs.offer(v);
    List<Integer> result = new ArrayList<>();
    Set<Integer> visited = new HashSet<>();
    visited.add(v);
    while(!bfs.isEmpty()) {
        int st = bfs.poll();
        result.add(st);
        for (int num : adjVertices.getOrDefault(st, new ArrayList<>())){
            if(!visited.contains(num)) bfs.offer(num);
            visited.add(num);
        }
    }
    for(int n : result) {
        System.out.print(n + " ");
    }
} 
