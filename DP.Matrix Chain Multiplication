   public int recursion(int i, int j, int[] a) {
        //if same, only one matrix considered, so result 0
        if(i == j) return 0;
        int minCost = Integer.MAX_VALUE;
        for(int k = i ; k < j; k++) {
            int steps = a[i - 1]*a[k]*a[j] + recursion(i, k, a) + recursion(k+1, j, a);
            minCost = Math.min(minCost, steps);
        }
        return minCost;
    }
    public int matrixChainMulitplication(int[] arr) {
        return recursion(1, arr.length - 1, arr);
    }
