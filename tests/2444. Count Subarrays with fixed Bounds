class Solution {
    public long countSubarrays(int[] nums, int minK, int maxK) {
        int min = -1, max = -1, wall = -1;
        long ans = 0;
        for(int i = 0; i < nums.length; i++) {
            if(nums[i] == minK) {
                min = i;
            }
            if (nums[i] == maxK) {
                max = i;
            }
            if(nums[i] > maxK || nums[i] < minK) {
                wall = i;
            }
            long curr = (long)Math.min(min, max) - (long)wall;
            if(curr > 0) ans+=curr;
        }
        return ans;
    }
}
