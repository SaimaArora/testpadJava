class Solution {
    public int maximumMinutes(int[][] grid) {
        int m = grid.length, n = grid[0].length;
        int[][] fireTime = new int[m][n];
        for(int[] i : fireTime) Arrays.fill(i, Integer.MAX_VALUE);
        Queue<int[]> fire = new LinkedList<>();
        for(int i = 0; i < m; i++) {
            for(int j = 0; j < n; j++) {
                if (grid[i][j] == 1) {
                    fire.offer(new int[]{i, j, 0});
                    fireTime[i][j] = 0;
                }
            }
        }
        int[] rows = {0, 0, -1, 1};
        int[] cols = {1, -1, 0, 0};
        while (!fire.isEmpty()) {
            int[] curr = fire.poll();
            int i = curr[0], j = curr[1], t = curr[2];
            for(int k = 0; k < 4; k++) {
                int newR = rows[k] + i, newC = cols[k] + j;
                if(newR >= 0 && newC >= 0 && newR < m && newC < n && grid[newR][newC] != 2 && fireTime[newR][newC] == Integer.MAX_VALUE) {
                    fire.offer(new int[]{newR, newC, t+1});
                    fireTime[newR][newC] = t+1;
                }
            }
        }
        int low = 0, high = 1000000000;
        int ans = -1;
        while(low <= high) {
            int mid = (low+high)/2;
            if(canReach(mid, fireTime, grid)) {
                ans = mid;
                low = mid+1;
            }
            else{
                high = mid -1;
            }
        }
        return ans;
    }
    private boolean canReach(int time, int[][] fireTime, int[][] grid) {
        if(time >= fireTime[0][0]) return false;
        int m = grid.length, n = grid[0].length;
        Queue<int[]> queue = new LinkedList<>();
        queue.offer(new int[]{0, 0, time});
        int[] rows = {0, 0 ,-1, 1};
        int[] cols = {1, -1, 0, 0};
        boolean visited[][] = new boolean[m][n];
        while(!queue.isEmpty()) {
            int[] curr = queue.poll();
            int i = curr[0], j = curr[1], t = curr[2];
            if(i == m - 1 && j == n - 1) return true;
            for(int k = 0; k < 4; k++) {
                int r = rows[k]+i, c = cols[k] + j, currT = t+1;
                if (r < m && c < n && r >= 0 && c >= 0 && grid[r][c] != 2 && !visited[r][c]) {
                    if(r == m - 1 && c == n - 1) {
                        if(currT <= fireTime[r][c]) {
                            queue.offer(new int[]{r, c, currT});
                            visited[r][c] = true;
                        }
                    }
                    else {
                        if(currT < fireTime[r][c]) {
                            queue.offer(new int[]{r, c, currT});
                            visited[r][c] = true;
                        }
                    }
                }
            }
        }
        return false;
    }
}
