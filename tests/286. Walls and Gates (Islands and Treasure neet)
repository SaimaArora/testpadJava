class Solution {
    class Node{
        int i, j;
        Node(int x, int y) {
            i = x;
            j = y;
        }
    }
    private boolean isValid(int i, int j, int[][] grid) {
        return i < grid.length && j < grid[0].length && i>=0 && j >=0 && grid[i][j] != -1;
    }
    public void islandsAndTreasure(int[][] grid) {
        Queue<Node> queue = new LinkedList<>();
        for (int i = 0; i < grid.length; i++) {
            for (int j = 0; j < grid[0].length; j++) {
                if(grid[i][j] == 0) {
                    queue.offer(new Node(i, j));
                }
            }
        }
        while (!queue.isEmpty()) {
            Node curr = queue.poll();
            int[] rows = {0, 0, 1, -1};
            int[] cols = {1, -1, 0, 0};
            for (int i = 0; i < 4; i++) {
                int newR = rows[i] + curr.i, newC = cols[i] + curr.j;
                if(isValid(newR, newC, grid)) {
                    int newDist = grid[curr.i][curr.j] + 1;
                    if (newDist < grid[newR][newC]) {
                        grid[newR][newC] = newDist;
                        queue.offer(new Node(newR, newC));
                    }
                }
            }
        }
        

    }
}
