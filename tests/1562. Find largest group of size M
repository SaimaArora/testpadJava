class Solution {
    public int findLatestStep(int[] arr, int m) {
        int n = arr.length, countM = 0, ans = 0;
        if(n == m) return n;
        int[] len = new int[n+2];  
        for (int i = 0; i < n; i++) {
            int num = arr[i];
            int left = len[num - 1];
            int right = len[num + 1];
            if(left == m) countM--;
            if(right == m) countM--;
            int sum = left+right+1;
            len[num - left] = sum;
            len[num + right] = sum;
            if(sum == m) {
                countM++;
            }
            if(countM > 0) ans = i+1;
        }
        return ans == 0? -1 : ans; 
    }
}
