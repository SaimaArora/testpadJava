class Solution {
    private int dfs(int curr, List<Integer>[] adj, boolean[] visited) {
        visited[curr] = true;
        int count = 1;
        for (int neigh : adj[curr]) {
            if(!visited[neigh]) {
                count += dfs(neigh, adj, visited);
            }
        }
        return count;
    }
    public int maximumDetonation(int[][] bombs) {
        int n = bombs.length;
        List<Integer>[] adj = new ArrayList[n];
        for(int i = 0; i < n; i++) adj[i] = new ArrayList<>();
        for (int i = 0; i < bombs.length; i++) {
            int x = bombs[i][0], y = bombs[i][1], r = bombs[i][2];
            for (int j = 0; j < bombs.length; j++) {
                if(i == j) continue;
                int x2 = bombs[j][0], y2 = bombs[j][1], r2 = bombs[j][2];
                long dist = (long)(x - x2)*(x - x2) + (long)(y - y2)*(y - y2);
                if(dist <= (long)r*r) {
                    adj[i].add(j);
                }  
            }
        }
        
        int max = 0;
        for(int i = 0; i < adj.length; i++) {
            boolean[] visited = new boolean[n];
            int count = dfs(i, adj, visited);
            max = Math.max(max, count);
        }
        return max;
    }
}
