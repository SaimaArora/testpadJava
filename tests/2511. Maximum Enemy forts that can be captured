class Solution {
    public int captureForts(int[] forts) {
        int end = 0, maxLen = 0;
        for(int i =0; i < forts.length; i++) {
            if(forts[i] != 0) {
                if(forts[i] == -forts[end]) {
                    maxLen = Math.max(maxLen, i - end - 1);
                }
                end = i;
            }
        }
        return maxLen;
    }
}
