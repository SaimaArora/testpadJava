class Solution {
    public int monotoneIncreasingDigits(int n) {
        int k = 9, num = n;
        int[] dig = new int[10];
        while(num > 0) {
            dig[k] = num%10;
            num = num /10;
            k--;
        }
        for (int i = 0; i < dig.length - 1; i++) {
            if(dig[i] > dig[i+1]) {
                dig[i]--;
                for(int j = i+1; j < dig.length; j++) {
                    dig[j] = 9;
                }
                i = -1;
            }
        }
        int x = 0;
        for(int i = 0; i < dig.length; i++) {
            x = x*10 + dig[i];
        }
        return x;
    }
}
