class Solution {
    public void dfs(int curr, List<Integer>[] adj, boolean[] visited) {
        visited[curr] = true;
        for(int neigh : adj[curr]) {
            if(!visited[neigh]) dfs(neigh, adj, visited);
        }
    }
    public int countComponents(int n, int[][] edges) {
        int count = 0;
        boolean[] visited = new boolean[n];
        List<Integer>[] adj = new ArrayList[n];
        for(int i = 0; i < n; i++) {
            adj[i] = new ArrayList<>();
        }
        for(int i = 0; i < edges.length; i++) {
            int u = edges[i][0], v = edges[i][1];
            adj[u].add(v);
            adj[v].add(u);
        }
        for(int i = 0; i < n; i++) {
            if(!visited[i]) {
                count++;
                dfs(i, adj, visited);
            }
        }
        return count;
    }
}
