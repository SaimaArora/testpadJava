class Solution {
    private int findMinDist(List<List<int[]>> adj) {
        PriorityQueue<int[]> pq = new PriorityQueue<>((a, b)-> a[1] - b[1]);
        pq.offer(new int[]{0, 0});
        int n = adj.size(), cost = 0;
        boolean[] visited = new boolean[n];
        while(!pq.isEmpty()){
            int[] curr = pq.poll();
            int u = curr[0], dis= curr[1];
            if(visited[u]) continue;
            visited[u] = true;
            cost+=dis;
            for(int[] neigh: adj.get(u)) {
                int distNeigh = neigh[1], v = neigh[0];
                if(!visited[v]) {
                    pq.offer(new int[]{v, distNeigh});
                }
            }
        }
        return cost;
    }
    public int minCostConnectPoints(int[][] points) {
        int n = points.length;
        List<List<int[]>> adj = new ArrayList<>();
        for(int i = 0; i < n; i++) adj.add(new ArrayList());
        for(int i = 0; i < n; i++){
            for(int j = i+1; j < n; j++) {
                int x1 = points[i][0], x2 = points[j][0], y1 = points[i][1], y2 = points[j][1];
                int dist = Math.abs(x1 - x2) + Math.abs(y1 - y2);
                adj.get(i).add(new int[]{j, dist}); 
                adj.get(j).add(new int[]{i, dist});
            }
        }
        return findMinDist(adj);
    }
}
