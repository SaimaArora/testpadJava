class Solution {
    public int countPrimes(int n) {
        boolean[] prime = new boolean[n];
        int count = 0;
        if(n == 1||n == 0) return 0;

        Arrays.fill(prime, true);
        prime[0] = false; prime[1] = false;
        for(int num = 2; num*num < n; num++) {
            if(prime[num] == true) {
                for(int fac = num*num; fac < n; fac += num) {
                    prime[fac] = false;
                }
            }
        }
        for(boolean val:prime) if(val) count++;
        return count;
    }
}
