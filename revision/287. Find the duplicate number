class Solution {
    public int findDuplicate(int[] nums) {
        int tor = nums[0], hare = nums[0];
        do{
            tor = nums[nums[tor]];
            hare = nums[hare];
        } while(tor != hare);
        tor = nums[0];
        while(tor != hare) {
            hare = nums[hare];
            tor= nums[tor];
        } return hare;

    }
}
