class Solution {
    public List<String> findRepeatedDnaSequences(String s) {
        Set<String> res = new HashSet<>();
        Set<Integer> seen = new HashSet<>();
        int[] map = new int[26];
        int n = s.length();
        if(n < 10) return new ArrayList<>();
        map['A' - 'A'] = 0;
        map['C' - 'A'] = 1;
        map['G' - 'A'] = 2;
        map['T' - 'A'] = 3;
        int mask = (1<< 20) - 1, curr = 0;
        for(int i = 0; i < 10; i++) {
            curr <<= 2;
            curr|=map[s.charAt(i) - 'A'];
        }
        seen.add(curr);
        for(int i = 10; i < n; i++){
            curr <<= 2;
            curr |= map[s.charAt(i) - 'A'];
            curr &= mask;
            if(seen.contains(curr)) res.add(s.substring(i - 9, i+1));
            seen.add(curr);
        }
        return new ArrayList<>(res);
    }
}
