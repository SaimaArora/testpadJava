class Solution {
    private boolean isValid(int i, int j, int[][] grid) {
        return i >= 0 && i < grid.length && j >= 0 && j < grid[0].length && (grid[i][j] == 0 || grid[i][j] == 2 || grid[i][j] == 1); 
    }
    private int dfs(int i, int j, int count, int total, int[][] grid) {
        if(!isValid(i, j, grid)) return 0;
        if (grid[i][j] == 2){
            return count == total?1:0; 
        }
        int temp = grid[i][j];
        grid[i][j] = -1;
        count++;
        int[] rows = {0, 0, -1, 1};
        int[] cols = {-1, 1, 0, 0};
        int ans = 0;
        for(int k = 0; k < 4; k++) {
            int newr = rows[k] + i, newc = cols[k] + j;
            ans+=dfs(newr, newc, count, total, grid);
        }
        grid[i][j] = temp;
        return ans;
    }
    public int uniquePathsIII(int[][] grid) {
        int total = 0, sti = -1, stj = -1, n = grid.length, m = grid[0].length;
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {
                if(grid[i][j] == 0) total++;
                if(grid[i][j] == 1){
                    sti = i; stj = j; total++;
                }
            }
        }
        return dfs(sti, stj, 0, total, grid);
        
    }
}
