class Solution {
    public long sumScores(String s) {
        int l = 0, r = 0, n = s.length();
        long total =n;
        int[] z = new int[n];
        for(int i = 1; i < n; i++) {
            //in the box
            if(i <= r) {
                int twin = i - l;
                z[i] = Math.min(r - i + 1, z[twin]);
            } 
            while(i + z[i] < n && s.charAt(z[i]) == s.charAt(i+z[i])) {
                z[i]++;
            }
            if(i+z[i] - 1 > r) {
                l = i;
                r = i + z[i] - 1;
            }
            total+=(long)z[i];
        }   
        return total;
    }
}
