    private void solve(int i, int j, int[][] maze, StringBuilder path, ArrayList<String> res) {
        if(i == maze.length - 1 && j == maze.length - 1) {
            res.add(path.toString());
            return;
        }
        int val = maze[i][j];
        maze[i][j] = 0;
        int[] rows = {1, 0, 0, -1};
        int[] cols = {0, -1, 1, 0};
        char[] dir = {'D','L','R','U'};
        for(int k = 0; k < 4; k++) {
            int newr = rows[k] + i, newc = cols[k] + j;
            if(newr < maze.length && newc < maze.length && newr >= 0 && newc >= 0 && maze[newr][newc] == 1) {
                path.append(dir[k]);
                solve(newr, newc, maze, path, res);
                path.deleteCharAt(path.length() - 1);
            }
        }
        maze[i][j] = val;
    }

    public ArrayList<String> findPath(int[][] maze) {
        int n = maze.length;
        if(maze[0][0] == 0 || maze[n - 1][n - 1] == 0) return new ArrayList<>();
        ArrayList<String> res = new ArrayList();
        solve(0,0, maze, new StringBuilder(), res);
        return res;
    }
