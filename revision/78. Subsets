class Solution {
    private void recursion(List<Integer> temp, List<List<Integer>> res, int[] nums, int ind) {
        res.add(new ArrayList(temp));
        for(int i = ind + 1; i <nums.length; i++) {
            temp.add(nums[i]);
            recursion(temp, res, nums, i);
            temp.remove(temp.size() - 1);
        }
    }
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> res = new ArrayList<>();
        recursion(new ArrayList<>(), res, nums, -1);
        return res;
    }
}
