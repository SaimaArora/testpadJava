class Solution {
    public int maxSubarraySumCircular(int[] nums) {
        int n = nums.length, maxRes = nums[0], minRes = nums[0];
        int minSum = nums[0], maxSum = nums[0], total = nums[0];
        for(int i = 1; i < n; i++) {
            minSum = Math.min(minSum + nums[i], nums[i]);
            minRes = Math.min(minRes, minSum);
            maxSum = Math.max(maxSum+nums[i], nums[i]);
            maxRes = Math.max(maxRes, maxSum);
            total+=nums[i];
        }
        int cir = total - minRes;
        if(cir == 0) return maxRes;
        return Math.max(cir, maxRes);
    }
}
