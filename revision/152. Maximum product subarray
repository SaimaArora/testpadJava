class Solution {
    public int maxProduct(int[] nums) {
        int maxi = nums[0], mini = nums[0], ans = nums[0], n = nums.length;
        for(int i = 1; i < n; i++) {
            if(nums[i] < 0) {
                int temp = maxi;
                maxi = mini;
                mini = temp;
            }
            maxi = Math.max(nums[i], maxi*nums[i]);
            mini = Math.min(nums[i], mini*nums[i]);
            ans = Math.max(ans, maxi);
        }   
        return ans;
    }
}
